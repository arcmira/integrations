{
    "name": "appmixer.arcmira.core.MakeApiCall",
    "label": "Make API Call (Advanced)",
    "description": "Advanced authenticated call to Arcmira\u2019s indexed YouTube API. GET reads data; POST, PUT, PATCH and DELETE may modify account data according to the selected endpoint and key scopes. A paid read uses credits from your plan, then your on-demand budget. Preserves full HTTP results. No automatic retries or quality fallback. API docs: https://arcmira.com/docs.",
    "author": "Arcmira <zeal@arcmira.com>",
    "version": "1.0.5",
    "auth": {
        "service": "appmixer:arcmira"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "PATCH",
                            "DELETE"
                        ]
                    },
                    "parameters": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "headers": {
                        "type": "string"
                    }
                },
                "required": [
                    "url",
                    "method"
                ],
                "additionalProperties": false
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "label": "API Endpoint Path",
                        "index": 1,
                        "tooltip": "Path relative to https://api.arcmira.com/v1/, such as search or /v1/monitors. Full URLs and path escapes are refused. Put query parameters in Parameters."
                    },
                    "method": {
                        "type": "select",
                        "label": "HTTP Method",
                        "index": 2,
                        "defaultValue": "GET",
                        "options": [
                            {
                                "content": "GET",
                                "value": "GET"
                            },
                            {
                                "content": "POST",
                                "value": "POST"
                            },
                            {
                                "content": "PUT",
                                "value": "PUT"
                            },
                            {
                                "content": "PATCH",
                                "value": "PATCH"
                            },
                            {
                                "content": "DELETE",
                                "value": "DELETE"
                            }
                        ],
                        "tooltip": "Write methods may create, change or delete data. Account key scopes and configured usage limits apply."
                    },
                    "parameters": {
                        "type": "key-value",
                        "label": "Parameters",
                        "index": 3,
                        "tooltip": "Query parameter key-value rows. Values are passed unchanged; no automatic pagination or filter changes."
                    },
                    "body": {
                        "type": "textarea",
                        "label": "JSON Body",
                        "index": 4,
                        "tooltip": "Valid JSON text for non-GET methods. Requests may modify data. No body is allowed for GET."
                    },
                    "headers": {
                        "type": "key-value",
                        "label": "Headers",
                        "index": 5,
                        "tooltip": "Allowed: Accept, Content-Type, If-Match, If-None-Match, Idempotency-Key, X-Request-ID. Authorization comes only from the managed account."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "statusCode": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "statusCode"
                    },
                    "headers": {
                        "type": "object",
                        "title": "headers"
                    },
                    "body": {
                        "title": "body"
                    }
                },
                "required": [
                    "statusCode",
                    "headers",
                    "body"
                ]
            }
        },
        {
            "name": "error",
            "schema": {
                "type": "object",
                "properties": {
                    "statusCode": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "statusCode"
                    },
                    "headers": {
                        "type": "object",
                        "title": "headers"
                    },
                    "body": {
                        "title": "body"
                    },
                    "error": {
                        "type": "object",
                        "title": "error"
                    },
                    "requestId": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "requestId"
                    },
                    "retryAfterSeconds": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "title": "retryAfterSeconds"
                    }
                },
                "required": [
                    "statusCode",
                    "headers",
                    "body"
                ]
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
