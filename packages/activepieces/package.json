{
  "name": "@arcmira/piece-arcmira",
  "version": "0.1.0",
  "description": "YouTube transcript search for Activepieces. Find timestamped passages across indexed videos and podcasts in a workflow.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
