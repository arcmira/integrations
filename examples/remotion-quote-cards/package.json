{
  "name": "arcmira-remotion-quote-cards",
  "private": true,
  "version": "0.1.0",
  "description": "Render source-linked quote cards from saved Arcmira YouTube transcript search results.",
  "homepage": "https://arcmira.com",
  "scripts": {
    "check": "tsc --noEmit",
    "render": "remotion render src/index.tsx QuoteCards out/quote-cards.mp4 --codec=h264 --concurrency=2",
    "still": "remotion still src/index.tsx QuoteCards out/quote-card.png --frame=90"
  },
  "dependencies": {
    "@remotion/cli": "4.0.531",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.531"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
